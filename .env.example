# Optional: override the Chrome binary used for recording.
# If unset, webreel downloads Chrome for Testing automatically.
# CHROME_PATH=/usr/bin/google-chrome

# Optional: override the ffmpeg binary used for video encoding.
# If unset, webreel downloads a static ffmpeg build automatically.
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# Optional: add HTTP request headers to every browser request made by preview/record.
# Value must be a JSON object whose values are strings.
# Keep authentication values in runtime secret storage, never in versioned config files.
# WEBREEL_REQUEST_HEADERS_JSON={"Authorization":"Bearer example"}
